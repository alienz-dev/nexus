# Nexus PKMS Configuration
version: "1"

# Database paths
database:
  main: ./data/nexus.sqlite
  vectors: ./data/vectors.lance

# Connected sources — edit these paths to match your setup
sources:
  vault:
    path: /path/to/your/obsidian-vault
    enabled: true
  github_stars:
    enabled: true
    # Token from GITHUB_TOKEN env var (needs read:user scope)
  raindrop:
    enabled: true
    # Token from RAINDROP_TOKEN env var (Settings > Integrations)

# RSS feeds (direct, not via RSSHub)
rss:
  feeds:
    - https://hnrss.org/frontpage
    - https://www.reddit.com/r/MachineLearning/.rss
    - https://dev.to/feed
    - https://tldr.tech/api/rss/ai

# RSSHub (for sources without native RSS)
rsshub:
  enabled: false
  url: http://localhost:1200
  routes: []

# LLM configuration — any OpenAI-compatible endpoint works
# Pick your provider and set endpoint + model:
#   LLM Router:  http://localhost:8642/v1 / openrouter/free  (auto-routes to best available)
#   DeepSeek:    https://api.deepseek.com/v1 / deepseek-chat
#   OpenAI:      https://api.openai.com/v1   / gpt-4o-mini
#   Ollama:      http://localhost:11434/v1    / llama3
#   LM Studio:   http://localhost:1234/v1    / local-model
llm:
  endpoint: http://localhost:8642/v1
  model: openrouter/free
  # apiKey: sk-...        # Or set LLM_API_KEY env var (not needed for llm-router)
  maxRetries: 2

# API server
server:
  port: 3777
  host: localhost

# Telegram notifications
telegram:
  enabled: false
  bot_token: ""
  chat_id: ""

# Search configuration
search:
  rrf_k: 60
  weights:
    bm25: 0.4
    vector: 0.4
    graph: 0.2
