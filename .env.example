# Nexus Environment Variables
# Copy to .env and fill in your values.

# ─── LLM Configuration ─────────────────────────────────────
# Used by the entity extraction LLM path (optional).
# If not set, only rule-based extraction is used.
LLM_API_KEY=your-api-key-here
LLM_ENDPOINT=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── Source API Keys ────────────────────────────────────────
# GitHub Stars bridge (needs read:user scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Raindrop.io bridge (Settings > Integrations)
RAINDROP_TOKEN=your-raindrop-token

# ─── Config Path ────────────────────────────────────────────
# Override default nexus.yaml location
# NEXUS_CONFIG=./path/to/nexus.yaml
